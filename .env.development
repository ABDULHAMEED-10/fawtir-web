# Committed defaults for `npm run dev` and `npm run preview`. Non-secret: these are hostnames.
# Override per machine in `.env.local`, which is gitignored (`*.local`) and wins over this file.
#
# Neither name carries the `VITE_` prefix, and that is the point: only `VITE_`-prefixed values are
# bundled into the client. These configure the dev SERVER's proxy, so the backend host never
# reaches the browser bundle and no feature module can depend on it.

# Where the dev server forwards every /api/* request. `src/config/api.ts` holds the fallback used
# when this is unset.
FAWTIR_API_ORIGIN=https://api.fawtir.om

# The Origin the proxy presents to that target, for a DEPLOYED backend only.
#
# Required here because a deployed allow-list cannot name the dev server: deploy-contabo.sh
# refuses to deploy an allow-list containing `localhost`. The value must be an origin the target
# already allows. Only the proxy-to-backend hop is relabelled — the browser still sees
# http://localhost:5173, so the session cookies stay host-only on localhost and the CSRF cookie
# stays readable.
#
# Leave it UNSET when FAWTIR_API_ORIGIN points at a local gateway: that gateway allow-lists the
# dev server's own origin, and setting this would send it an origin it does not expect.
FAWTIR_API_PROXY_ORIGIN=https://www.fawtir.om
