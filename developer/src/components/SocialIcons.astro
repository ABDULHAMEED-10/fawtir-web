---
// Top bar links, in the slot Starlight keeps for social icons: the main sections, and the way
// back to the product (app.fawtir.om) and the company site (fawtir.om).
const { lang } = Astro.locals.starlightRoute
const ar = lang === 'ar'
const links = ar
  ? [
      ['الدليل', '/guide/'],
      ['واجهة البرمجة', '/api/reference/'],
      ['الأخطاء', '/reference/errors/'],
    ]
  : [
      ['Guide', '/guide/'],
      ['API reference', '/api/reference/'],
      ['Errors', '/reference/errors/'],
    ]
const path = Astro.url.pathname.replace(/^\/ar\//, '/')
const base = ar ? '/ar' : ''
---

<nav class="top" aria-label={ar ? 'الأقسام' : 'Sections'}>
  {
    links.map(([label, href]) => (
      <a href={base + href} aria-current={path.startsWith(href) ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
<a class="cta" href="https://app.fawtir.om" rel="noopener">
  {ar ? 'افتح فوتر' : 'Open Fawtir'}
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
    ><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    ></path></svg
  >
</a>

<style>
  .top {
    display: flex;
    gap: 1.5rem;
    margin-inline-end: 0.5rem;
  }
  .top a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .top a:hover,
  .top a[aria-current='page'] {
    color: var(--sl-color-accent);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    background: var(--fw-blue);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta:hover {
    background: var(--fw-blue-hover);
    color: #fff;
  }
  :global([dir='rtl']) .cta svg {
    transform: scaleX(-1);
  }
  /* In the header the links give way below 72rem; the phone menu always shows them. */
  @media (max-width: 72rem) {
    :global(.header) .top {
      display: none;
    }
  }
  :global(.mobile-preferences) .top {
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
